# Скопируйте этот файл в .env и при необходимости поменяйте значения
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar
POSTGRES_DB=avatar_service
POSTGRES_PORT=5432
# DSN, который будет использовать приложение (server + worker)
DATABASE_URL=postgres://avatar:avatar@postgres:5432/avatar_service?sslmode=disable

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- MinIO (S3-совместимое хранилище) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=avatars

# --- Приложение ---
SERVER_PORT=8080
