<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>GophProfile — галерея аватарок {{.UserID}}</title>
  <style>
    body { font-family: sans-serif; max-width: 720px; margin: 40px auto; padding: 0 16px; }
    .grid { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 16px; }
    .card { border: 1px solid #ccc; border-radius: 8px; padding: 8px; width: 140px; text-align: center; }
    .card img { width: 100px; height: 100px; object-fit: cover; border-radius: 4px; }
    .status { font-size: 12px; color: #555; }
  </style>
</head>
<body>
  <h1>Галерея аватарок пользователя {{.UserID}}</h1>
  <p><a href="/web/upload">Загрузить ещё</a></p>
  {{if not .Avatars}}
    <p>У пользователя пока нет загруженных аватарок.</p>
  {{else}}
  <div class="grid">
    {{range .Avatars}}
    <div class="card">
      <img src="/api/v1/avatars/{{.ID}}?size=100x100" alt="{{.FileName}}">
      <div>{{.FileName}}</div>
      <div class="status">загрузка: {{.UploadStatus}}</div>
      <div class="status">обработка: {{.ProcessingStatus}}</div>
    </div>
    {{end}}
  </div>
  {{end}}
</body>
</html>
